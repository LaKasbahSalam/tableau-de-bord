{
  // Tableau de bord Kasbah — un Worker, sans build : `npx wrangler deploy`
  "name": "kasbah-tableau-de-bord",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    // Projet Supabase « Kasbah Analytics » (réf. publique, pas un secret)
    "SUPABASE_URL": "https://sebwcxxoxpfbliypzokp.supabase.co",
    "GITHUB_ORG": "LaKasbahSalam"
  }
  // Secrets, posés dans Cloudflare (Workers → kasbah-tableau-de-bord →
  // Paramètres → Variables et secrets), jamais dans ce fichier :
  //   MOT_DE_PASSE          ouvre la page
  //   GITHUB_TOKEN          jeton GitHub, lecture seule sur les 4 dépôts
  //   MOT_DE_PASSE_INVESTISSEUR  ouvre la vue /investisseur, en lecture seule
  //   SUPABASE_ANON_KEY     clé publique (anon / publishable) de Kasbah Analytics
  //   SUPABASE_CLE_TABLEAU  clé rendue par la migration 20260922090000_tableau_de_bord.sql
}
